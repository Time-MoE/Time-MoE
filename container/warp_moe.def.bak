Bootstrap: docker
From: pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

%labels
    Author chengjie.zheng001
    Project WARP-MoE_26KDD

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PIP_NO_CACHE_DIR=1

%post
    set -eux

    # Basic OS deps
    apt-get update && apt-get install -y --no-install-recommends \
        git wget curl ca-certificates \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

    # Python tooling
    python -m pip install --upgrade pip setuptools wheel

    # JupyterLab + wandb (runtime essentials)
    python -m pip install --no-cache-dir jupyterlab wandb

    # (Project deps) install from requirements.txt at runtime via bind-mount repo
    # so the container remains reusable across branches/experiments.
